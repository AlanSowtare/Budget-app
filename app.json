{
  "expo": {
    "name": "Depensio",
    "slug": "budget-app",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/fonts/budgetIcon.jpeg",
    "scheme": "budgetapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": ["ios", "android"],
    "ios": {
      "buildNumber": "3",
      "supportsTablet": true,
      "bundleIdentifier": "com.alsoftware.depensio",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.alsoftware.budgetapp",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/fonts/budgetIcon.jpeg",
        "backgroundColor": "#0d0f14"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/fonts/budgetIcon.jpeg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/fonts/budgetIconSplash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-asset",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6e19e861-5973-45d1-a2b7-077e5c3df6b7"
      }
    }
  }
}
